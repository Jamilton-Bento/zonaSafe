# ============================================================================
# Central de TI — variáveis de ambiente
# Copie para ".env" e substitua TODOS os valores "TROQUE". Nunca versione o .env.
# Gere segredos fortes no PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
# ============================================================================

# --- Portas publicadas (somente em 127.0.0.1) ---
WEB_PORT=8081
EVOLUTION_PORT=8080

# --- PostgreSQL (não é publicado no host) ---
POSTGRES_PASSWORD=TROQUE_senha_superusuario_postgres
CENTRAL_DB_PASSWORD=TROQUE_senha_banco_central
EVOLUTION_DB_PASSWORD=TROQUE_senha_banco_evolution

# --- Redis (não é publicado no host) ---
REDIS_PASSWORD=TROQUE_senha_redis

# --- Back-end ---
# Mínimo de 32 caracteres
JWT_SECRET=TROQUE_segredo_jwt_com_pelo_menos_32_caracteres
# Primeiro administrador (criado só se ainda não existir). Troque a senha depois do primeiro acesso.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.local
ADMIN_PASSWORD=TROQUE_senha_admin_minimo_10_caracteres
# true somente se publicar o sistema atrás de HTTPS
COOKIE_SECURE=false

# --- Evolution API (v2.3.7) ---
# Chave global da Evolution API: usada SOMENTE pelo back-end. Nunca vai ao navegador.
EVOLUTION_API_KEY=TROQUE_chave_evolution_forte
EVOLUTION_INSTANCE=central-ti
# Segredo enviado pela Evolution API no cabeçalho x-webhook-secret (mín. 24 caracteres)
WEBHOOK_SECRET=TROQUE_segredo_webhook_com_pelo_menos_24_caracteres

# --- Proteções de envio do WhatsApp ---
WA_MIN_SEND_INTERVAL_MS=5000
WA_MAX_SENDS_PER_DAY=50
WA_MAX_CONSECUTIVE_FAILURES=3
WA_CONNECT_COOLDOWN_MS=30000

# --- Retenção de mensagens (dias); pode ser alterada em Configurações ---
RETENTION_MESSAGE_DAYS=180

# --- IA (Gemini, plano GRATUITO do Google AI Studio) ---
# Crie a chave em https://aistudio.google.com/apikey SEM habilitar faturamento.
# ATENÇÃO À PRIVACIDADE: com a IA ativada, o texto das mensagens (com e-mails, CPF/CNPJ e telefones mascarados)
# é enviado ao Google. No plano gratuito o Google pode usar esse conteúdo para melhorar seus produtos.
# Deixe vazio para manter a IA indisponível (o restante do sistema funciona normalmente).
GEMINI_API_KEY=
# Nome do modelo; confira os modelos gratuitos vigentes na documentação do Google e ajuste se necessário
GEMINI_MODEL=gemini-2.5-flash
# Proteção da cota gratuita
AI_MIN_INTERVAL_MS=5000
AI_DAILY_LIMIT=150
AI_MAX_CONSECUTIVE_FAILURES=5
